---
import '../styles/trinity-tokens.css';
import '../styles/trinity-components.css';
import { pageTitle, canonical, ogImageUrl, organisationSchema } from '../lib/seo';
import type { Seo, SiteSettings } from '../lib/types';
import RuleBar from '../components/RuleBar.astro';
import Masthead from '../components/Masthead.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  seo: Seo;
  site: SiteSettings;
  /** Extra JSON-LD for this page — breadcrumbs, FAQs, the service offered. */
  schemas?: Array<Record<string, unknown>>;
  bodyClass?: string;
  /** Selectors the entrance animation should reveal on scroll. */
  reveal?: string;
}

const { seo, site, schemas = [], bodyClass, reveal } = Astro.props;

const origin = Astro.site?.origin ?? 'https://trinitypawnbrokers.co.uk';
const href = canonical(Astro.url.pathname, origin);
const title = pageTitle(seo, site);
const ogImage = ogImageUrl(seo, site);

// The organisation appears on every page and is referenced by @id from the
// per-page schemas, so Google resolves them into one entity.
const allSchemas = [organisationSchema(site, origin), ...schemas];
---

<!doctype html>
<html lang="en-GB" data-nav="closed">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={href} />

    {seo.noIndex && <meta name="robots" content="noindex, nofollow" />}
    {!seo.noIndex && <meta name="robots" content="index, follow, max-image-preview:large" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:url" content={href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={seo.description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}

    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={seo.description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <meta name="theme-color" content="#10271C" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Archivo:wght@400;500;600;700&display=swap"
    />

    <link rel="preconnect" href="https://unpkg.com" crossorigin />
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/light/style.css" />
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/fill/style.css" />

    {
      allSchemas.map((schema) => (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
      ))
    }

    <slot name="head" />
  </head>

  <body
    class={bodyClass}
    data-confirm-notes={site.showConfirmNotes ? 'on' : 'off'}
    data-reveal={reveal}
  >
    <RuleBar site={site} />
    <Masthead site={site} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter site={site} />

    <script>
      import '../scripts/trinity-nav.js';
      import '../scripts/trinity-reveal.js';
    </script>
  </body>
</html>
