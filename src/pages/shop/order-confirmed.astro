---
import '../../styles/shop.css';
import Base from '../../layouts/Base.astro';
import { getLegalPages, getSiteSettings } from '../../lib/sanity/queries';

/* Prerendered, like every other page here. The order itself is fetched from
   /api/order by the script below — on deployed Cloudflare Pages the adapter's
   streamed HTML arrives as the literal string "[object Object]", so a
   server-rendered page shows a blank screen to someone who has just paid.
   A static shell asking an API route for its content avoids that entirely. */

const [site, legals] = await Promise.all([getSiteSettings(), getLegalPages()]);
const hasReturns = legals.some((page) => page.slug === 'shipping-and-returns');

const seo = {
  title: 'Order confirmed | Trinity Pawnbrokers',
  description: 'Thank you for your order.',
  noIndex: true,
};
---
<Base seo={seo} site={site} nav="shop">

  <section class="tr-band tr-band--white">
    <div class="tr-inner confirm">
      {/* One heading, whatever the state. Three headers each with their own
          h1 — two of them hidden — still put three h1s in the document, and
          the page has one subject however it turns out.

          It opens on "Confirming your order…" because someone who has just
          paid should never see an empty page, nor a "not found" that turns
          out to be wrong a moment later. */}
      <header class="shop-head confirm__head">
        <p class="tr-eyebrow">Order <span data-order-ref></span></p>
        <h1 class="shop-head__title" data-order-heading>Confirming your order…</h1>
        <p class="shop-head__intro" data-order-intro hidden></p>
      </header>

      <div data-order-missing hidden>
        <p class="shop-head__intro">
          If you have just paid, your card has not been charged twice by reloading this
          page. Call us on <a href={`tel:${site.phoneHref}`}>{site.phone}</a> with the email
          address you used and we will find it.
        </p>
      </div>

      <div data-order-found hidden>

        <ul class="confirm__list" data-order-lines></ul>

        <div class="confirm__total">
          <span>Paid</span>
          <strong data-order-total></strong>
        </div>

        <div class="confirm__next">
          <h2 class="confirm__next-title">What happens now</h2>
          <ol class="confirm__steps">
            <li>We check the piece over once more, photograph it as it leaves us, and pack it.</li>
            <li>It travels insured and signed-for. We will email you the tracking details.</li>
            <li>
              Fourteen days from the day it arrives, you can send it back for a full refund.
              {hasReturns && <> <a href="/shipping-and-returns">How returns work</a></>}
            </li>
          </ol>
        </div>

        <p class="confirm__help">
          Any questions, quote order <strong data-order-ref></strong> and call
          {' '}<a href={`tel:${site.phoneHref}`}>{site.phone}</a>.
        </p>

        <a class="tr-cta tr-cta--ghost" href="/shop/items">Back to the shop</a>
      </div>
    </div>
  </section>

  <script>
    import '../../scripts/cart.js';
    import '../../scripts/order-confirmed.js';
  </script>
</Base>
