---
import '../../styles/shop.css';
import Base from '../../layouts/Base.astro';
import ShopHero from '../../components/shop/ShopHero.astro';
import ProductCard from '../../components/shop/ProductCard.astro';
import CardGrid from '../../components/CardGrid.astro';
import ClosingBand from '../../components/ClosingBand.astro';
import SectionOpener from '../../components/SectionOpener.astro';
import ShopStory from '../../components/shop/ShopStory.astro';
import { getShopPage, getProducts, getSiteSettings } from '../../lib/sanity/queries';
import { breadcrumbSchema } from '../../lib/seo';

const [shop, products, site] = await Promise.all([
  getShopPage(),
  getProducts(),
  getSiteSettings(),
]);
const origin = Astro.site?.origin ?? '';

/* Three, because the copy promises three — the team's picks for the month.
   Only what is actually buyable: a sold piece here would be a shop window
   full of things you cannot have. */
const featured = products.filter((p) => p.status === 'available').slice(0, 3);
const forSale = products.filter((p) => p.status === 'available').length;

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: `${origin}/` },
    { name: 'Shop', url: `${origin}/shop` },
  ]),
];

const reveal = '.product-card, .shop-assurances .tr-card, .shop-story__copy > *';
---
<Base seo={shop.seo} site={site} schemas={schemas} reveal={reveal} nav="shop">
  {shop.hero && <ShopHero hero={shop.hero} />}

  <section class="tr-band tr-band--white">
    <div class="tr-inner">
      <SectionOpener intro={shop.featured} />

      {featured.length > 0 ? (
        <>
          <div class="product-grid">
            {featured.map((product) => <ProductCard product={product} />)}
          </div>
          <a class="shop-head__all" href="/shop/items">
            See all {forSale > 3 ? `${forSale} watches` : 'watches'} →
          </a>
        </>
      ) : (
        <p class="shop-empty">
          Everything is currently sold. Pieces arrive as loans end —
          {' '}<a class="tr-inline-link" href="/contact">tell us what you are looking for</a>.
        </p>
      )}
    </div>
  </section>

  <section class="tr-band tr-band--grey">
    <div class="tr-inner shop-assurances">
      <SectionOpener intro={shop.intro} />
      <CardGrid cards={shop.assurances} class="shop-assurances__grid" />
    </div>
  </section>

  {shop.story && <ShopStory story={shop.story} />}

  <ClosingBand closing={shop.closing} site={site} />

  <script>
    import '../../scripts/cart.js';
  </script>
</Base>
