---
import Base from '../layouts/Base.astro';
import AssetPageBody from '../components/AssetPageBody.astro';
import LegalPageBody from '../components/LegalPageBody.astro';
import { getAssetPages, getLegalPages, getSiteSettings } from '../lib/sanity/queries';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../lib/seo';
import type { AssetPage, LegalPage, SiteSettings } from '../lib/types';

/**
 * Item pages and legal pages share the top level so the addresses stay short —
 * /watches and /privacy, not /legal/privacy. One route resolves both rather
 * than two dynamic routes colliding at the same path depth.
 */
export async function getStaticPaths() {
  const [assets, legals, site] = await Promise.all([
    getAssetPages(),
    getLegalPages(),
    getSiteSettings(),
  ]);

  return [
    ...assets.map((page) => ({ params: { slug: page.slug }, props: { kind: 'asset' as const, page, site } })),
    ...legals.map((page) => ({ params: { slug: page.slug }, props: { kind: 'legal' as const, page, site } })),
  ];
}

type Props =
  | { kind: 'asset'; page: AssetPage; site: SiteSettings }
  | { kind: 'legal'; page: LegalPage; site: SiteSettings };

const props = Astro.props as Props;
const { site } = props;
const origin = Astro.site?.origin ?? '';

const schemas: Array<Record<string, unknown>> = [];
let reveal: string | undefined;

if (props.kind === 'asset') {
  const page = props.page;
  schemas.push(
    serviceSchema(page, site, origin),
    breadcrumbSchema([
      { name: 'Home', url: `${origin}/` },
      { name: page.title, url: `${origin}/${page.slug}` },
    ]),
  );
  if (page.faqs?.items?.length) schemas.push(faqSchema(page.faqs.items));
  reveal = [
    '.lend-grid > *', '.borrow-grid > *', '.how-grid > .how-step', '.value-points > *',
    '.compare-grid > *', '.proof-grid > *', '.faq-item', '.rep-card', '.closing-inner > *',
  ].join(', ');
} else {
  schemas.push(
    breadcrumbSchema([
      { name: 'Home', url: `${origin}/` },
      { name: props.page.title, url: `${origin}/${props.page.slug}` },
    ]),
  );
}
---

<Base seo={props.page.seo} site={site} schemas={schemas} reveal={reveal}>
  {props.kind === 'asset' ? (
    <AssetPageBody page={props.page} site={site} />
  ) : (
    <LegalPageBody page={props.page} />
  )}
</Base>
