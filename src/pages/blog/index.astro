---
import '../../styles/blog.css';
import Base from '../../layouts/Base.astro';
import { getBlogIndex, getPosts, getSiteSettings } from '../../lib/sanity/queries';
import { breadcrumbSchema } from '../../lib/seo';
import { urlFor } from '../../lib/sanity/image';

const [index, posts, site] = await Promise.all([getBlogIndex(), getPosts(), getSiteSettings()]);
const origin = Astro.site?.origin ?? '';

const seo = index?.seo ?? {
  title: 'Blog',
  description: 'Notes on pawnbroking, valuation, and looking after what you own.',
};

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: `${origin}/` },
    { name: index?.title ?? 'Blog', url: `${origin}/blog` },
  ]),
];

const dateOf = (iso: string) =>
  new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

/**
 * The lead article: whichever is ticked as featured, or the newest if none is.
 * Posts already arrive newest first, so the first match is the right one
 * either way, and several ticked resolves to the most recent of them.
 */
const featured = posts.find((post) => post.featured) ?? posts[0];
const rest = posts.filter((post) => post !== featured);
---
<Base seo={seo} site={site} schemas={schemas} reveal=".blog-card">
  <section class="blog-head">
    <div class="blog-head__inner">
      {index?.eyebrow && <p class="tr-eyebrow">{index.eyebrow}</p>}
      <h1>{index?.title ?? 'Blog'}</h1>
      {index?.standfirst && <p class="blog-head__standfirst">{index.standfirst}</p>}
    </div>
  </section>

  {featured && (
    <section class="blog-featured">
      <div class="blog-featured__inner">
        <a href={`/blog/${featured.slug}`}>
          <span class="blog-featured__media">
            <img
              src={urlFor(featured.coverImage).width(1100).height(734).fit('crop').url()}
              alt={featured.coverImage.alt ?? ''}
              width="1100"
              height="734"
              fetchpriority="high"
              decoding="async"
            />
          </span>
          <span>
            <span class="blog-featured__label">Latest</span>
            <h2 class="blog-featured__title">{featured.title}</h2>
            <p class="blog-featured__excerpt">{featured.excerpt}</p>
            <time class="blog-featured__date" datetime={featured.publishedAt}>
              {dateOf(featured.publishedAt)}
            </time>
          </span>
        </a>
      </div>
    </section>
  )}

  <section class="blog-list">
    {posts.length === 0 ? (
      <p class="blog-empty">No articles yet.</p>
    ) : rest.length === 0 ? null : (
      <>
      <p class="blog-list__label">More articles</p>
      <div class="blog-grid">
        {rest.map((post) => (
          <article class="blog-card">
            <a href={`/blog/${post.slug}`}>
              <span class="blog-card__media">
                <img
                  src={urlFor(post.coverImage).width(720).height(480).fit('crop').url()}
                  alt={post.coverImage.alt ?? ''}
                  width="720"
                  height="480"
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <time class="blog-card__date" datetime={post.publishedAt}>{dateOf(post.publishedAt)}</time>
              <h2 class="blog-card__title">{post.title}</h2>
              <p class="blog-card__excerpt">{post.excerpt}</p>
            </a>
          </article>
        ))}
      </div>
      </>
    )}
  </section>
</Base>
