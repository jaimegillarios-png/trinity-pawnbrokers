---
import type { FaqItem } from '../lib/types';
interface Props { items?: FaqItem[] }
const { items = [] } = Astro.props;
---
{items.length > 0 && (
  <div class="faq-list">
    {items.map((item) => (
      <details class="faq">
        <summary class="faq__q">{item.q}</summary>
        <div class="faq__a"><p>{item.a}</p></div>
      </details>
    ))}
  </div>
)}
