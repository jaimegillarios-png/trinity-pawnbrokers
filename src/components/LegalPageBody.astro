---
import '../styles/prose.css';
import { PortableText } from 'astro-portabletext';
import type { LegalPage } from '../lib/types';

interface Props { page: LegalPage }
const { page } = Astro.props;

const updated = new Date(page.updatedAt).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---
<section class="tr-band tr-band--white">
  <div class="legal-page">
    <h1 class="tr-h2">{page.title}</h1>
    {/* Regulated policies have to say when they last changed. */}
    <p class="tr-caption">Last updated {updated}</p>
    <div class="tr-prose">
      <PortableText value={page.body as any} />
    </div>
  </div>
</section>
