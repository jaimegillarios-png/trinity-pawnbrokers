---
import type { HeroSection, SpecRow } from '../../lib/types';
import { urlFor, srcSetFor, lqipFor } from '../../lib/sanity/image';
import { splitEmphasis } from '../../lib/text';

interface Props { hero: HeroSection; record?: SpecRow[] }
const { hero, record = [] } = Astro.props;
const parts = splitEmphasis(hero.heading);
const lqip = lqipFor(hero.image);
---
{/*
  Every other page opens with a photograph, a scrim, and the headline laid on
  top. This one splits instead: the statement in the first column, the
  photograph in the second, both inside the container. The record runs along
  the foot of the copy like the address line on a letterhead.
*/}
<section class="about-masthead" aria-labelledby="about-title">
  <div class="about-masthead__inner">
    <div class="about-masthead__copy">
      {hero.eyebrow && <p class="tr-eyebrow about-masthead__eyebrow">{hero.eyebrow}</p>}
      <h1 id="about-title" class="about-masthead__title">
        {parts.map((p) => (p.emphasis ? <em>{p.text}</em> : p.text))}
      </h1>
      <p class="about-masthead__intro">{hero.intro}</p>

      <div class="about-masthead__actions">
        <a href={hero.ctaPrimary.href} class="tr-cta tr-cta--gold">{hero.ctaPrimary.label}</a>
        {hero.ctaGhost && (
          <a href={hero.ctaGhost.href} class="tr-cta about-masthead__ghost">{hero.ctaGhost.label}</a>
        )}
      </div>

      {record.length > 0 && (
        <dl class="about-record" aria-label="The record">
          {record.map((row) => (
            <div class="about-record__cell">
              <dt>{row.label}</dt>
              <dd>{row.value}</dd>
            </div>
          ))}
        </dl>
      )}
    </div>

    <figure class="about-masthead__figure">
      <img
        src={urlFor(hero.image).width(1100).url()}
        srcset={srcSetFor(hero.image)}
        sizes="(max-width: 900px) 100vw, 45vw"
        alt={hero.image.alt ?? ''}
        width={hero.image.asset?.metadata?.dimensions?.width}
        height={hero.image.asset?.metadata?.dimensions?.height}
        style={lqip ? `background-image:url(${lqip});background-size:cover` : undefined}
        fetchpriority="high"
        decoding="async"
      />
    </figure>
  </div>
</section>
