---
import type { SiteSettings } from '../lib/types';
interface Props { site: SiteSettings }
const { site } = Astro.props;
---
{/* Wordmark first in the DOM as well as on screen: the mobile menu orders
    these three with `order`, and matching the source order keeps the reading
    and tab order the same as the visual one. */}
<header class="masthead">
  <div class="masthead-grid">
    <a href="/" class="tr-wordmark" aria-label={`${site.name} — home`}>
      <img
        class="tr-logo"
        src="/brand/trinity-logo.svg"
        alt=""
        width="179"
        height="20"
        decoding="async"
      />
    </a>

    {/* One nav, not two. The pair was an artefact of the old three-column bar
        with the wordmark between them; with the logo on the left they are a
        single run of links, and the mobile menu's stagger no longer has to
        guess which group an item is in. */}
    <nav aria-label="Main">
      <div class="nav-panel">
        <a href="/what-we-lend-against" class="tr-navlink">What we lend against</a>
        <a href="/#how" class="tr-navlink">How it works</a>
        <a href="/trust-and-security" class="tr-navlink">Trust &amp; security</a>
        <a href="/blog" class="tr-navlink">Blog</a>
        <a href="/about" class="tr-navlink">About</a>
        <a href={`tel:${site.phoneHref}`} class="tr-phone-btn">{site.phone}</a>
      </div>
    </nav>

    <a
      class="tr-call"
      href={`tel:${site.phoneHref}`}
      aria-label={`Call ${site.name} on ${site.phone}`}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M6.8 3.5h2.6a1 1 0 0 1 1 .79l.66 3.05a1 1 0 0 1-.5 1.1L8.9 9.6a12.6 12.6 0 0 0 5.5 5.5l1.16-1.66a1 1 0 0 1 1.1-.5l3.05.66a1 1 0 0 1 .79 1v2.6a2 2 0 0 1-2.16 2C10.7 18.65 5.35 13.3 4.8 5.66a2 2 0 0 1 2-2.16z"></path>
      </svg>
    </a>

    <button class="tr-burger" type="button" aria-label="Menu" aria-expanded="false" hidden>
      <span></span><span></span>
    </button>
  </div>
</header>
