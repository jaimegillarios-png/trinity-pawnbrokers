---
import { PortableText } from 'astro-portabletext';
import { urlFor, croppedSrcSetFor, lqipFor } from '../../lib/sanity/image';
import type { ShopPage } from '../../lib/types';

interface Props {
  story: NonNullable<ShopPage['story']>;
  /**
   * The heading level. h2 by default, because this reads as a section; h1
   * where it opens a page of its own, as on /shop/about — which had no h1 at
   * all until this was configurable. The size follows the level: the CSS keys
   * off the element, so changing one cannot leave the other behind.
   */
  as?: 'h1' | 'h2';
}
const { story, as: Heading = 'h2' } = Astro.props;
const lqip = story.image ? lqipFor(story.image) : undefined;
---
{/* Built like the shop hero — equal columns, the same 56px gutter, the same
    square plate — so the shop's two split sections read as a pair rather than
    as two attempts at the same idea. Copy first for the same reason it is
    first there. */}
<section class="tr-band tr-band--white shop-story">
  <div class="tr-inner shop-story__inner">
    <div class="shop-story__copy">
      {story.heading && <Heading class="shop-story__title">{story.heading}</Heading>}
      <PortableText value={story.body as any} />
    </div>
    {story.image && (
      <div class="shop-story__media">
        <img
          src={urlFor(story.image).width(1000).height(1000).fit('crop').url()}
          srcset={croppedSrcSetFor(story.image, 1)}
          sizes="(max-width: 900px) 100vw, 42vw"
          alt={story.image.alt ?? ''}
          width="1000"
          height="1000"
          loading="lazy"
          decoding="async"
          style={lqip ? `background-image:url(${lqip});background-size:cover` : undefined}
        />
      </div>
    )}
  </div>
</section>
