---
/**
 * The shop's own bar, under the site masthead. The masthead stays because the
 * shop is Trinity, not a separate business — this is the second level, and it
 * is where the cart lives.
 */
const { pathname } = Astro.url;
const here = (href: string) => pathname === href || pathname === `${href}/`;

const links = [
  { href: '/shop', label: 'Shop' },
  { href: '/shop/items', label: 'All items' },
];
---
<nav class="shop-nav" aria-label="Shop">
  <div class="shop-nav__inner">
    <a class="shop-nav__mark" href="/shop">
      <span class="shop-nav__mark-label">Trinity</span>
      <span class="shop-nav__mark-word">Shop</span>
    </a>

    <div class="shop-nav__links">
      {links.map((link) => (
        <a href={link.href} aria-current={here(link.href) ? 'page' : undefined}>{link.label}</a>
      ))}
    </div>

    <a class="shop-nav__cart" href="/shop/cart" aria-current={here('/shop/cart') ? 'page' : undefined}>
      Cart
      {/* Filled by the cart script; starts empty so no-JS shows no false count. */}
      <span class="shop-nav__count" data-cart-count hidden></span>
    </a>
  </div>
</nav>
