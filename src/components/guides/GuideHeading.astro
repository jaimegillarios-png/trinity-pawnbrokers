---
/* h2 and h3 both carry the anchor withContents() stamped on them, so every
   section and sub-section can be linked to directly. */
const { node } = Astro.props as { node: { anchor?: string; style?: string } };
const Tag = node.style === 'h3' ? 'h3' : 'h2';
---
<Tag id={node.anchor} class={Tag === 'h2' ? 'guide-section' : 'guide-subsection'}><slot /></Tag>
