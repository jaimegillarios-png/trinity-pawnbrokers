---
/* A section heading carrying the anchor lib/guides.ts stamped on it, so the
   contents list can link here. The id comes from the node, not from anything
   computed in this component, which is what keeps the two in step. */
const { node } = Astro.props as { node: { anchor?: string } };
---
<h2 id={node.anchor} class="guide-section"><slot /></h2>
