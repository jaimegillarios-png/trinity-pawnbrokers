---
// A faithful port of legacy/src/templates/asset-page.mjs. The structure,
// class names and inline styles are deliberately identical — this is the
// same page, driven by Sanity instead of a content file.
import '../styles/asset-page.css';
import Hero from './Hero.astro';
import ValuationForm from './ValuationForm.astro';
import IconCard from './IconCard.astro';
import Ledger from './Ledger.astro';
import Faqs from './Faqs.astro';
import ConfirmChip from './ConfirmChip.astro';
import { splitEmphasis } from '../lib/text';
import type { AssetPage, SiteSettings } from '../lib/types';

interface Props { page: AssetPage; site: SiteSettings }
const { page, site } = Astro.props;

const step = (i: number) => `Step ${String(i + 1).padStart(2, '0')}`;
const whyHeading = page.why?.intro?.heading ? splitEmphasis(page.why.intro.heading) : [];
---

<Hero hero={page.hero}>
  <Fragment slot="aside"><ValuationForm form={page.form} /></Fragment>

  <Fragment slot="below">
    {page.trust && page.trust.length > 0 && (
      <div class="trust">
        <div class="trust-inner">
          {page.trust.map((t) => (
            <span class={t.highlight ? 'trust__highlight' : undefined}>
              {t.text}<ConfirmChip note={t.chip} />
            </span>
          ))}
        </div>
      </div>
    )}
  </Fragment>
</Hero>

{page.lendAgainst && (
  <section id="index" class="tr-band tr-band--white">
    <div class="tr-inner">
      <div class="tr-head">
        {page.lendAgainst.intro?.eyebrow && <p class="tr-eyebrow">{page.lendAgainst.intro.eyebrow}</p>}
        {page.lendAgainst.intro?.heading && <h2 class="tr-h2">{page.lendAgainst.intro.heading}</h2>}
      </div>
      {page.lendAgainst.intro?.intro && (
        <p class="tr-intro tr-section-intro">{page.lendAgainst.intro.intro}</p>
      )}
      <div class="lend-grid">
        {(page.lendAgainst.cards ?? []).map((c) => <IconCard card={c} />)}
      </div>
    </div>
  </section>
)}

{page.borrow && (
  <section class="tr-band tr-band--grey">
    <div class="tr-inner">
      <div class="borrow-grid">
        <div>
          {page.borrow.intro?.eyebrow && <p class="tr-eyebrow">{page.borrow.intro.eyebrow}</p>}
          {page.borrow.intro?.heading && (
            <h2 class="tr-h2 section-h2--tight">{page.borrow.intro.heading}</h2>
          )}
          {page.borrow.intro?.intro && (
            <p class="tr-body borrow-intro">{page.borrow.intro.intro}</p>
          )}

          <div class="tr-specs">
            {(page.borrow.specs ?? []).map((s) => (
              <div>
                <p class="tr-spec__label">{s.label}<ConfirmChip note={s.chip} /></p>
                <p class="tr-spec__value">{s.value}</p>
              </div>
            ))}
          </div>
        </div>

        {page.borrow.example && (
          <div class="tr-card tr-card--panel example-panel">
            <div class="tr-spec__label panel-label">
              {page.borrow.example.label}<ConfirmChip note={page.borrow.example.chip} />
            </div>
            {page.borrow.example.statement && (
              <p class="rep-card__statement example-panel__statement">
                {page.borrow.example.statement}
              </p>
            )}
            <Ledger rows={page.borrow.example.rows} />
            {page.borrow.example.note && (
              <p class="tr-body-sm example-panel__note">{page.borrow.example.note}</p>
            )}
          </div>
        )}
      </div>
    </div>
  </section>
)}

{page.how && (
  <section id="how" class="tr-band tr-band--white">
    <div class="tr-inner">
      <div class="tr-head--centred">
        {page.how.intro?.eyebrow && <p class="tr-eyebrow">{page.how.intro.eyebrow}</p>}
        {page.how.intro?.heading && <h2 class="tr-h2">{page.how.intro.heading}</h2>}
      </div>

      <div id="how-track">
        <div class="how-line how-line--track" aria-hidden="true"></div>
        <div class="how-line how-line--fill" aria-hidden="true"></div>
        <div class="how-grid">
          {(page.how.steps ?? []).map((s, i) => (
            <div class="how-step">
              <div class="how-num" aria-hidden="true">
                <span class="how-num__glyph">
                  <i class={`ph-fill ${s.icon}`}></i><i class={`ph-light ${s.icon}`}></i>
                </span>
              </div>
              <p class="how-step__label">{step(i)}</p>
              <h4 class="tr-h4">{s.title}<ConfirmChip note={s.chip} /></h4>
              <p>{s.body}</p>
            </div>
          ))}
        </div>
      </div>

      {page.how.link && (
        <p class="how-link">
          <a href={page.how.link.href} class="tr-inline-link">{page.how.link.label}</a>
        </p>
      )}
    </div>
  </section>
)}

{page.valuation && (
  <section class="tr-band tr-band--grey">
    <div class="tr-inner">
      <div class="value-split">
        <div class="tr-sticky">
          {page.valuation.intro?.eyebrow && <p class="tr-eyebrow">{page.valuation.intro.eyebrow}</p>}
          {page.valuation.intro?.heading && (
            <h2 class="tr-h2 section-h2--tight">{page.valuation.intro.heading}</h2>
          )}
          {page.valuation.intro?.intro && (
            <p class="tr-body value-intro">{page.valuation.intro.intro}</p>
          )}
        </div>
        <div class="value-points">
          {(page.valuation.points ?? []).map((c) => <IconCard card={c} />)}
        </div>
      </div>
    </div>
  </section>
)}

{page.why && (
  <section class="tr-band tr-band--white">
    <div class="tr-inner why-inner">
      <div class="why-head">
        {page.why.intro?.eyebrow && <p class="tr-eyebrow">{page.why.intro.eyebrow}</p>}
        <h2 class="tr-h2">
          {whyHeading.map((part) =>
            part.emphasis ? <span class="why-head__accent">{part.text}</span> : part.text,
          )}
        </h2>
        {page.why.intro?.intro && <p class="tr-intro">{page.why.intro.intro}</p>}
      </div>

      <div class="compare-grid">
        <div class="cmp-head-spacer"></div>
        <div class="cmp-head-tri"><div>Trinity</div></div>
        <div class="cmp-head-hs"><div>The high street</div></div>
        {(page.why.rows ?? []).map((r) => (
          <>
            <div class="cmp-row"><i class={`ph-light ${r.icon}`} aria-hidden="true"></i>{r.label}</div>
            <div class="cmp-tri">
              <i class="ph-fill ph-check-circle" aria-hidden="true"></i>
              <span>{r.trinity}<ConfirmChip note={r.trinityChip} /></span>
            </div>
            <div class="cmp-hs">
              <i class="ph-light ph-x" aria-hidden="true"></i><span>{r.highStreet}</span>
            </div>
          </>
        ))}
      </div>
    </div>
  </section>
)}

{page.proof && (
  <section class="tr-band tr-band--grey">
    <div class="proof-grid">
      <div>
        <div
          id="badge-200"
          class="reviews-badge"
          data-reviews-badge
          data-store={site.reviewsStore}
          data-colour-token="--tr-gold-deep"
        ></div>
        {page.proof.reviewsNote && (
          <p class="tr-body reviews-note">{page.proof.reviewsNote}</p>
        )}
      </div>

      {page.proof.caseStudy && (
        <div class="tr-card tr-card--panel">
          <p class="tr-spec__label panel-label">
            {page.proof.caseStudy.label}<ConfirmChip note={page.proof.caseStudy.chip} />
          </p>
          {page.proof.caseStudy.statement && (
            <p class="case-statement">
              {page.proof.caseStudy.statement}
            </p>
          )}
          <Ledger rows={page.proof.caseStudy.rows} small />
          {page.proof.caseStudy.note && (
            <p class="tr-caption case-note">{page.proof.caseStudy.note}</p>
          )}
        </div>
      )}
    </div>
  </section>
)}

{page.faqs && (
  <section class="tr-band tr-band--white">
    <div class="tr-inner">
      <div class="faq-split">
        <div class="tr-sticky">
          {page.faqs.intro?.eyebrow && <p class="tr-eyebrow">{page.faqs.intro.eyebrow}</p>}
          {page.faqs.intro?.heading && <h2 class="tr-h2">{page.faqs.intro.heading}</h2>}
        </div>
        <Faqs items={page.faqs.items} />
      </div>
    </div>
  </section>
)}

{page.repExample && (
  <section class="tr-band tr-band--grey">
    <div
      class="tr-inner tr-inner--narrow rep-inner"
    >
      <div class="rep-card">
        <p class="tr-spec__label rep-card__label">
          {page.repExample.label}<ConfirmChip note={page.repExample.chip} />
        </p>
        <p class="rep-card__statement">{page.repExample.statement}</p>
        {page.repExample.note && (
          <p class="tr-body-sm rep-card__note">
            {page.repExample.note}
          </p>
        )}
      </div>
    </div>
  </section>
)}

{page.closing && (
  <section class="closing">
    <div class="closing-inner">
      {page.closing.eyebrow && (
        <p class="tr-eyebrow tr-eyebrow--on-green closing__eyebrow">{page.closing.eyebrow}</p>
      )}
      <h2>{page.closing.heading}</h2>
      {page.closing.intro && <p class="closing__intro">{page.closing.intro}</p>}
      {page.closing.cta && (
        <a href={page.closing.cta.href} class="tr-cta tr-cta--gold">{page.closing.cta.label}</a>
      )}
      {page.closing.contactPrefix && (
        <p class="closing__contact">
          {page.closing.contactPrefix} <a href={`tel:${site.phoneHref}`}>{site.phone}</a>{' '}
          {page.closing.contactSuffix}
        </p>
      )}
    </div>
  </section>
)}

<script>
  import '../scripts/asset-page.js';
</script>
