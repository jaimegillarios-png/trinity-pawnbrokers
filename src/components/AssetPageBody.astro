---
// Scoped to item pages: the hero, valuation form, trust strip and comparison
// table are only used here.
import '../styles/asset-page.css';
import Hero from './Hero.astro';
import TrustStrip from './TrustStrip.astro';
import ValuationForm from './ValuationForm.astro';
import SectionOpener from './SectionOpener.astro';
import CardGrid from './CardGrid.astro';
import Ledger from './Ledger.astro';
import Faqs from './Faqs.astro';
import ConfirmChip from './ConfirmChip.astro';
import type { AssetPage, SiteSettings } from '../lib/types';

interface Props { page: AssetPage; site: SiteSettings }
const { page, site } = Astro.props;
---


  <Hero hero={page.hero}>
    <Fragment slot="aside"><ValuationForm form={page.form} /></Fragment>
  </Hero>

  <TrustStrip items={page.trust} />

  {page.lendAgainst && (
    <section class="tr-band tr-band--white" id="index">
      <div class="tr-inner">
        <SectionOpener intro={page.lendAgainst.intro} />
        <CardGrid cards={page.lendAgainst.cards} class="lend-grid" />
      </div>
    </section>
  )}

  {page.borrow && (
    <section class="tr-band tr-band--grey">
      <div class="tr-inner">
        <SectionOpener intro={page.borrow.intro} />
        <div class="borrow-grid">
          <Ledger rows={page.borrow.specs} />
          {page.borrow.example && (
            <div class="tr-card tr-card--panel">
              <p class="tr-microcaps">
                {page.borrow.example.label}<ConfirmChip note={page.borrow.example.chip} />
              </p>
              {page.borrow.example.statement && <p class="tr-body">{page.borrow.example.statement}</p>}
              <Ledger rows={page.borrow.example.rows} />
              {page.borrow.example.note && <p class="tr-body-sm">{page.borrow.example.note}</p>}
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  {page.how && (
    <section class="tr-band tr-band--white" id="how">
      <div class="tr-inner">
        <SectionOpener intro={page.how.intro} />
        <CardGrid cards={page.how.steps} class="how-grid" />
        {page.how.link && <a class="tr-inline-link" href={page.how.link.href}>{page.how.link.label}</a>}
      </div>
    </section>
  )}

  {page.valuation && (
    <section class="tr-band tr-band--grey">
      <div class="tr-inner">
        <SectionOpener intro={page.valuation.intro} />
        <CardGrid cards={page.valuation.points} class="value-points" />
      </div>
    </section>
  )}

  {page.why?.rows?.length && (
    <section class="tr-band tr-band--green">
      <div class="tr-inner">
        <div class="why-head"><SectionOpener intro={page.why.intro} onGreen /></div>
        <div class="compare-grid">
          {page.why.rows.map((row) => (
            <>
              <div class="cmp-row">
                {row.icon && <i class={`ph-light ${row.icon}`} aria-hidden="true"></i>}
                {row.label}
              </div>
              <div class="cmp-tri">
                <span>{row.trinity}<ConfirmChip note={row.trinityChip} /></span>
              </div>
              <div class="cmp-hs"><span>{row.highStreet}</span></div>
            </>
          ))}
        </div>
      </div>
    </section>
  )}

  {page.proof && (
    <section class="tr-band tr-band--grey">
      <div class="proof-grid">
        <div>
          {/* The badge draws its colour from the gold token at runtime, so it
              stays on-brand without a hex being pasted into the markup. */}
          <div
            id="badge-200"
            style="width:200px;margin-bottom:20px"
            data-reviews-badge
            data-store={site.reviewsStore}
            data-colour-token="--tr-gold-deep"
          ></div>
          {page.proof.reviewsNote && (
            <p class="tr-body" style="margin:0;max-width:44ch">{page.proof.reviewsNote}</p>
          )}
        </div>

        {page.proof.caseStudy && (
          <div class="tr-card tr-card--panel">
            <p class="tr-spec__label" style="margin-bottom:16px">
              {page.proof.caseStudy.label}<ConfirmChip note={page.proof.caseStudy.chip} />
            </p>
            {page.proof.caseStudy.statement && (
              <p style="font:500 var(--tr-h3) var(--tr-font-display);line-height:1.45;margin:0;color:var(--tr-green-vault);text-wrap:pretty">
                {page.proof.caseStudy.statement}
              </p>
            )}
            <Ledger rows={page.proof.caseStudy.rows} />
            {page.proof.caseStudy.note && (
              <p class="tr-caption" style="margin:22px 0 0">{page.proof.caseStudy.note}</p>
            )}
          </div>
        )}
      </div>
    </section>
  )}

  {page.faqs && (
    <section class="tr-band tr-band--white">
      <div class="tr-inner">
        <div class="faq-split">
          <div class="tr-sticky">
            {page.faqs.intro?.eyebrow && <p class="tr-eyebrow">{page.faqs.intro.eyebrow}</p>}
            {page.faqs.intro?.heading && <h2 class="tr-h2">{page.faqs.intro.heading}</h2>}
          </div>
          <Faqs items={page.faqs.items} />
        </div>
      </div>
    </section>
  )}

  {page.repExample && (
    <section class="tr-band tr-band--grey">
      <div class="tr-inner tr-inner--narrow">
        <p class="tr-microcaps">
          {page.repExample.label}<ConfirmChip note={page.repExample.chip} />
        </p>
        <p class="tr-body">{page.repExample.statement}</p>
        {page.repExample.note && <p class="tr-body-sm">{page.repExample.note}</p>}
      </div>
    </section>
  )}

  {page.closing && (
    <section class="closing tr-band tr-band--green">
      <div class="closing-inner">
        {page.closing.eyebrow && <p class="tr-eyebrow tr-eyebrow--on-green">{page.closing.eyebrow}</p>}
        <h2 class="tr-h2 tr-h2--on-green">{page.closing.heading}</h2>
        {page.closing.intro && <p class="tr-intro">{page.closing.intro}</p>}
        {page.closing.cta && (
          <a href={page.closing.cta.href} class="tr-cta tr-cta--gold">{page.closing.cta.label}</a>
        )}
        {page.closing.contactPrefix && (
          <p class="tr-body-sm">
            {page.closing.contactPrefix}
            <a href={`tel:${site.phoneHref}`} class="tr-inline-link">{site.phone}</a>
            {page.closing.contactSuffix}
          </p>
        )}
      </div>
    </section>
  )}

<script>
  import '../scripts/asset-page.js';
</script>
