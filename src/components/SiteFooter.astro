---
import type { SiteSettings } from '../lib/types';
import { getAssetPageCards, getLegalPages } from '../lib/sanity/queries';

interface Props { site: SiteSettings }
const { site } = Astro.props;

/* Driven off the CMS so a new item page appears here without anyone
   remembering to add it. */
const items = await getAssetPageCards();

/* The legal bar links only to policies that exist. These are CMS documents, so
   the set can differ between environments — and a footer that promises a terms
   of sale page and delivers a 404 is worse on a regulated site than anywhere
   else. Ordered here, filtered by what Sanity actually holds. */
const published = new Set((await getLegalPages()).map((page) => page.slug));

/* Pages the sitemap calls for but that do not exist yet. They are listed so
   the structure is visible, but deliberately not linked — a footer link to a
   404 is worse than no link. Give one a route here and it becomes a link. */
type Entry = { label: string; href?: string };

const house: Entry[] = [
  { label: 'How it works', href: '/how-it-works' },
  { label: 'Guides', href: '/guides' },
  { label: 'About the house', href: '/about' },
  { label: 'Blog', href: '/blog' },
  { label: 'Shop', href: '/shop' },
  { label: 'FAQs', href: '/faq' },
  { label: 'Contact us', href: '/contact' },
];

const legal = [
  { label: 'Terms of business', slug: 'terms' },
  { label: 'Terms of sale', slug: 'terms-of-sale' },
  { label: 'Shipping & returns', slug: 'shipping-and-returns' },
  { label: 'Privacy policy', slug: 'privacy' },
  { label: 'Cookie policy', slug: 'cookies' },
  { label: 'Complaints procedure', slug: 'complaints' },
].filter((entry) => published.has(entry.slug));

const addr = site.address;
const addressLines = [
  addr?.street,
  [addr?.locality, addr?.postcode].filter(Boolean).join(' '),
].filter(Boolean) as string[];

const year = new Date().getFullYear();
---
<footer class="tr-footer">
  <div class="tr-footer__inner">
    <div class="tr-footer__brand">
      <a class="tr-footer__id" href="/" aria-label={`${site.name} — home`}>
        <img
          class="tr-footer__logo"
          src="/brand/trinity-logo-reversed.svg"
          alt=""
          width="179"
          height="20"
          decoding="async"
        />
      </a>

      <p class="tr-footer__blurb">
        Discreet, FCA-regulated loans against watches, jewellery, gold and fine art —
        your item held in insured custody until you redeem it.
      </p>

      <div class="tr-footer__contact">
        <a class="tr-footer__phone" href={`tel:${site.phoneHref}`}>{site.phone}</a>
        {site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}
        {addressLines.length > 0 && (
          <address class="tr-footer__address">
            {addressLines.map((line, i) => <>{i > 0 && <br />}{line}</>)}
          </address>
        )}
      </div>
    </div>

    <nav class="tr-footer__col" aria-label="Assets">
      <h2 class="tr-footer__col-title">Assets</h2>
      <ul class="tr-footer__list">
        {items.map((item) => (
          <li><a href={`/${item.slug}`}>{item.title}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="tr-footer__col" aria-label="The house">
      <h2 class="tr-footer__col-title">The house</h2>
      <ul class="tr-footer__list">
        {house.map((entry) => (
          <li>
            {entry.href
              ? <a href={entry.href}>{entry.label}</a>
              : <span class="tr-footer__pending">{entry.label}</span>}
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="tr-footer__bar">
    <div class="tr-footer__bar-inner">
      <p class="tr-footer__copy">© {year} {site.name}</p>
      <nav class="tr-footer__legal-nav" aria-label="Legal">
        {legal.map((entry) => <a href={`/${entry.slug}`}>{entry.label}</a>)}
      </nav>
    </div>
  </div>
</footer>
