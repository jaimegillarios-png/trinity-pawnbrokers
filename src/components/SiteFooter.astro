---
import type { SiteSettings } from '../lib/types';
interface Props { site: SiteSettings }
const { site } = Astro.props;
---
<footer class="tr-footer">
  <span class="tr-mark" aria-hidden="true">
    <span></span>
    <span class="tr-mark__pair"><span></span><span></span></span>
  </span>
  <div class="tr-footer__name">Trinity</div>
  <div class="tr-footer__sub">Pawnbrokers</div>


  <nav class="tr-footer__nav" aria-label="Site">
    <a href="/blog">Blog</a>
  </nav>

  <div class="tr-footer__legal">{site.legalFooter}</div>
</footer>
