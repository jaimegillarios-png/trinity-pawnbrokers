{
  "color": {
    "green": {
      "vault":  { "value": "#10271C", "use": "hero, statement bands, CTA text" },
      "footer": { "value": "#0B1D14", "use": "footer, top rule bar (darkest)" },
      "leaf":   { "value": "#1D3D2C", "use": "links, hover states" }
    },
    "gold": {
      "deep":   { "value": "#8A6B26", "use": "eyebrows, icons, numerals on light" },
      "mid":    { "value": "#C9A857", "use": "gold accents on green, chips" },
      "bright": { "value": "#D8B968", "use": "primary CTA fill, hero italics" }
    },
    "neutral": {
      "white":     { "value": "#FFFFFF", "use": "alternating bands, cards, fields, masthead" },
      "grey":      { "value": "#F5F4F2", "use": "alternating bands, panels on white, light text on green" },
      "warmPanel": { "value": "#FAF8F3", "use": "form card on green, card hover on light" },
      "ink":       { "value": "#1B1F1C", "use": "body text" }
    },
    "status": {
      "success": { "value": "#5FA982", "use": "confirm ticks, reassurance markers" }
    },
    "onGreen": {
      "strong": "rgba(245,241,230,0.85)",
      "base":   "rgba(245,241,230,0.72)",
      "muted":  "rgba(245,241,230,0.65)",
      "faint":  "rgba(245,241,230,0.60)"
    },
    "ink": {
      "80": "rgba(27,31,28,0.80)",
      "72": "rgba(27,31,28,0.72)",
      "68": "rgba(27,31,28,0.68)",
      "62": "rgba(27,31,28,0.62)",
      "45": "rgba(27,31,28,0.45)"
    },
    "line": {
      "soft":   "rgba(27,31,28,0.14)",
      "base":   "rgba(27,31,28,0.16)",
      "card":   "rgba(27,31,28,0.18)",
      "strong": "rgba(27,31,28,0.30)",
      "gold":   "rgba(138,107,38,0.40)"
    }
  },
  "font": {
    "display": "'Cormorant Garamond', Georgia, serif",
    "body":    "'Archivo', Arial, sans-serif",
    "caps":    "'Archivo', Arial, sans-serif"
  },
  "type": {
    "display": { "family": "display", "weight": 500, "size": "clamp(46px,5.4vw,76px)", "line": 1.06, "use": "homepage hero only" },
    "h1":      { "family": "display", "weight": 500, "size": "clamp(40px,4.6vw,64px)", "line": 1.08, "use": "interior page heroes" },
    "h2":      { "family": "display", "weight": 500, "size": "38px", "line": 1.15, "use": "EVERY section heading, no exceptions" },
    "stat":    { "family": "display", "weight": 500, "size": "32px", "line": 1.15, "use": "stat figures" },
    "h3":      { "family": "display", "weight": 600, "size": "24px", "line": 1.25, "use": "card & component headings" },
    "h4":      { "family": "display", "weight": 600, "size": "20px", "line": 1.3,  "use": "step titles, FAQ questions" },
    "quote":   { "family": "display", "weight": 500, "size": "clamp(24px,2.6vw,30px)", "line": 1.5, "use": "pull-quote statements on green" },
    "bodyLg":  { "family": "body", "weight": 400, "size": "17px", "line": 1.7, "use": "intros" },
    "body":    { "family": "body", "weight": 400, "size": "16px", "line": 1.7, "use": "section body" },
    "bodySm":  { "family": "body", "weight": 400, "size": "14.5px", "line": 1.6, "use": "card body" },
    "label":   { "family": "body", "weight": 400, "size": "15px", "line": 1.45, "use": "form labels" },
    "caption": { "family": "body", "weight": 400, "size": "13.5px", "line": 1.6, "use": "legal, footnotes" },
    "eyebrow": { "family": "caps", "weight": 500, "size": "13px", "line": 1, "track": "0.28em", "transform": "uppercase", "color": "gold.deep" },
    "microCaps": { "family": "caps", "weight": 500, "size": "12.5px", "line": 1.5, "track": "0.12em-0.2em", "transform": "uppercase" },
    "nav":      { "family": "body", "weight": 600, "size": "12.5px", "track": "0.14em", "transform": "uppercase" },
    "button":   { "family": "body", "weight": 700, "size": "13px", "track": "0.16em", "transform": "uppercase" },
    "textLink": { "family": "body", "weight": 700, "size": "12px", "track": "0.18em", "transform": "uppercase" }
  },
  "space": {
    "container": "1240px",
    "reading": "860px",
    "padSide": "28px",
    "sectionTop": "104px",
    "sectionBottom": "110px",
    "gapCard": "20px",
    "gapCol": "48px-64px"
  },
  "shape": {
    "radius": "3px",
    "radiusChip": "2px",
    "shadowOnGreen": "0 24px 48px rgba(0,0,0,0.35)",
    "shadowOnLight": "0 14px 28px rgba(16,39,28,0.10)"
  }
}
