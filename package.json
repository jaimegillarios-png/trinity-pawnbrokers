{
  "name": "trinity-pawnbrokers",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "wrangler pages dev ./dist",
    "deploy": "SITE_URL=${SITE_URL:-https://trinity-pawnbrokers.pages.dev} astro build && node scripts/strip-worker.mjs && wrangler pages deploy ./dist --project-name trinity-pawnbrokers --commit-dirty=true",
    "studio": "npm --prefix studio run dev",
    "studio:deploy": "npm --prefix studio run deploy",
    "astro": "astro",
    "test": "node --test tests/*.test.mjs",
    "test:build": "astro build && node --test tests/*.test.mjs",
    "verify": "astro check && astro build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/sitemap": "^3.7.3",
    "@sanity/client": "^7.26.2",
    "@sanity/image-url": "^1.2.0",
    "astro": "^5.18.2",
    "astro-portabletext": "^0.13.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@sanity/types": "^6.10.1",
    "lightningcss": "^1.33.0"
  }
}
