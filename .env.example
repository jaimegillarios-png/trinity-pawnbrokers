# Sanity — from sanity.io/manage → your project → API
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Optional: a read token lets the build render unpublished drafts.
# Create it under API → Tokens with Viewer permission. Never commit it.
SANITY_API_READ_TOKEN=

# The canonical origin. Drives sitemap URLs, canonical tags and Open Graph.
SITE_URL=https://trinitypawnbrokers.co.uk

# --- Shop ---
# Stripe. Test keys (sk_test_…) until the client's account is live.
# Dashboard → Developers → API keys.
STRIPE_SECRET_KEY=
# Dashboard → Developers → Webhooks → your endpoint → signing secret (whsec_…).
# Without this the webhook rejects everything, and nothing is ever marked sold.
STRIPE_WEBHOOK_SECRET=

# A Sanity token with Editor permission. The checkout route holds stock with it
# and the webhook marks pieces sold. Separate from the read token above so it
# can be rotated on its own.
SANITY_API_WRITE_TOKEN=
