# Sanity — from sanity.io/manage → your project → API
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Optional: a read token lets the build render unpublished drafts.
# Create it under API → Tokens with Viewer permission. Never commit it.
SANITY_API_READ_TOKEN=

# The canonical origin. Drives sitemap URLs, canonical tags and Open Graph.
SITE_URL=https://trinitypawnbrokers.co.uk
